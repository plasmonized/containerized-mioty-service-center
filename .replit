modules = ["python-3.11"]
run = "python main.py"

[nix]
channel = "stable-25_05"
packages = ["borgbackup", "cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc"]

[deployment]
run = ["sh", "-c", "py main.py"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 16018
externalPort = 3001

[[ports]]
localPort = 16019
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "BSSCI Service"
mode = "sequential"
author = 45640243

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python web_main.py"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "BSSCI Service"

[agent]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
